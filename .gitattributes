# Normalise line endings for text files
* text=auto

# Shell scripts must keep LF, also when checked out on Windows
*.sh text eol=lf

# Binary files: no line-ending conversion, no textual diffs
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.psd binary
*.zip binary
*.proverlay binary
*.mp4 binary
*.mov binary
